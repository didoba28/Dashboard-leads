# Copiez ce fichier vers .env.local et complétez selon vos besoins.
# Rien n'est obligatoire pour démarrer : sans Notion ni Slack configurés,
# l'application fonctionne normalement (import CSV, saisie manuelle, API).

# --- Base de données ---------------------------------------------------------

# Chemin du fichier SQLite. Optionnel : par défaut, data/leads.db (relatif au
# dossier du projet) est créé automatiquement au premier accès.
# DATABASE_PATH=data/leads.db

# Force un pilote SQLite précis : `node` (module node:sqlite intégré, défaut
# dès Node 22.5) ou `better` (paquet better-sqlite3, repli pour Node plus
# ancien). Optionnel : sans valeur, le meilleur pilote disponible est choisi.
# SQLITE_DRIVER=node

# Réservé à une bascule PostgreSQL/Supabase (voir docs/SUPABASE.md). Absent
# par défaut : le dashboard utilise SQLite tant que cette variable n'est pas
# définie.
# DATABASE_URL=postgresql://user:password@localhost:5432/dashboard_leads

# --- Notion --------------------------------------------------------------------

# Jeton de l'intégration Notion interne (Settings → Connections → Develop or
# manage integrations, sur notion.so). Sans lui, Notion reste désactivé : les
# écrans de la page Intégrations affichent « non configuré » et les routes
# /api/notion/* renvoient une erreur explicite plutôt que d'échouer en silence.
# NOTION_TOKEN=ntn_votre_jeton_ici

# Base Notion à rattacher (partagez-la au préalable avec l'intégration ci-
# dessus). Si absente, renseignez NOTION_PARENT_PAGE_ID pour laisser le
# dashboard créer la base, ou configurez-la depuis la page Intégrations.
# NOTION_DATABASE_ID=

# Page Notion parente sous laquelle créer la base, si NOTION_DATABASE_ID n'est
# pas renseigné. Sans l'une ou l'autre, la configuration Notion échoue avec un
# message explicite.
# NOTION_PARENT_PAGE_ID=

# --- Ingestion Slack (#inbound) ------------------------------------------------

# Signing secret de l'application Slack (Basic Information → App Credentials).
# Sans lui, l'endpoint /api/ingest/slack rejette toutes les requêtes (401) :
# mieux vaut un webhook fermé qu'un webhook ouvert qui pollue les objectifs.
# SLACK_SIGNING_SECRET=

# --- Ingestion e-mail (notifications de formulaire) ----------------------------

# Jeton porteur de votre choix, à transmettre en en-tête
# `Authorization: Bearer $INGEST_TOKEN` (ou en paramètre ?token=) sur
# /api/ingest/email. Sans lui, cet endpoint est fermé.
# INGEST_TOKEN=changez-moi-en-un-jeton-aleatoire

# --- Divers --------------------------------------------------------------------

# URL publique du dashboard, uniquement utilisée pour composer les exemples
# d'appel affichés sur la page Intégrations (URL du webhook Slack, exemple
# curl pour l'ingestion e-mail…). Optionnel.
# APP_URL=https://votre-domaine.fr
